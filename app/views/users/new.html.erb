<div class="d-flex justify-content-center align-items-center" style="min-height: 90vh;">
  <div class="container">
    <div class="row">
      <div class="col-md-6 offset-md-5">
        <h1>Cadastro</h1>
      </div>
      <div class="">
        <%= form_for @user do |f| %>
          <%= render 'layouts/error_messages', object: f.object %>
          <div class="form-group">
            <div class="col-md-6 offset-md-3">
              <%= f.text_field :name, placeholder: 'Nome', class: 'form-control' %>
            </div>
          </div>
          <br>
          <div class="form-group">
            <div class="col-md-6 offset-md-3">
              <%= f.email_field :email, placeholder: 'E-mail', class: 'form-control' %>
            </div>
          </div>
          <br>
          <div class="form-group">
            <div class="col-md-6 offset-md-3">
              <%= f.password_field :password, placeholder: 'Senha', class: 'form-control' %>
            </div>
          </div>
          <br>
          <div class="form-group">
            <div class="col-md-6 offset-md-3">
              <%= f.password_field :password_confimation, placeholder:'Confirmar Senha', class: 'form-control' %>
              <br>
              <%= f.submit 'Cadastrar' , class: 'btn btn-primary' %>
            </div>
          </div>
          <br>
        <% end %>
      </div>
    </div>
  </div>
</div>
