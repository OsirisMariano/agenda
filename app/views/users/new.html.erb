<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
          <h5 class="mb-0"><i class="bi bi-person-plus me-2"></i>Criar Nova Conta</h5>
        </div>
        <div class="card-body">
          <%= form_with model: @user, local: true do |f| %>
            <div class="mb-3">
              <%= f.label :name, "Nome", class: 'form-label' %>
              <%= f.text_field :name, class: form_field_class(f, :name), placeholder: 'Seu nome completo' %>
              <%= form_field_error(f, :name) %>
            </div>
            <div class="mb-3">
              <%= f.label :email, "E-mail", class: 'form-label' %>
              <%= f.email_field :email, class: form_field_class(f, :email), placeholder: 'seu@email.com' %>
              <%= form_field_error(f, :email) %>
            </div>
            <div class="mb-3">
              <%= f.label :password, "Senha", class: 'form-label' %>
              <%= f.password_field :password, class: form_field_class(f, :password), placeholder: 'Mínimo 6 caracteres' %>
              <%= form_field_error(f, :password) %>
            </div>
            <div class="mb-3">
              <%= f.label :password_confirmation, "Confirmar Senha", class: 'form-label' %>
              <%= f.password_field :password_confirmation, class: form_field_class(f, :password_confirmation), placeholder: 'Repita a senha' %>
              <%= form_field_error(f, :password_confirmation) %>
            </div>
            <div class="d-grid">
              <%= f.submit "Criar Conta", class: 'btn btn-success' %>
            </div>
          <% end %>
          <div class="mt-3 text-center">
            <small class="text-muted">Já tem conta? <%= link_to 'Entrar', entrar_path %></small>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>