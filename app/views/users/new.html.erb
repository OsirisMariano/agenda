<div class="row">
  <div class="col-md-6 offset-md-5">
    <h1>Cadastra-se</h1>
  </div>
  <div class="">
    <%= form_for @user do |f| %>
      <!--<%= render 'layouts/error_messages', object: f.object %>-->
      <div class="form-group">
        <div class="col-md-6 offset-md-3">
          <%= f.label :name %>
          <%= f.text_field :name, class: 'form-control' %>
        </div>
      </div>
      <br>
      <div class="form-group">
        <div class="col-md-6 offset-md-3">
          <%= f.label :email %>
          <%= f.email_field :email, class: 'form-control' %>
        </div>
      </div>
      <br>
      <div class="form-group">
        <div class="col-md-6 offset-md-3">
          <%= f.label :passwrod %>
          <%= f.password_field :passwrod, class: 'form-control' %>
        </div>
      </div>
      <br>
      <div class="form-group">
        <div class="col-md-6 offset-md-3">
          <%= f.label :passwrod_confimation %>
          <%= f.password_field :passwrod_confimation, class: 'form-control' %>
          <br>
          <%= f.submit 'Cadastrar' , class: 'btn btn-primary' %>
        </div>
      </div>
      <br>
    <% end %>
  </div>
</div>
