<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><i class="bi bi-person-gear me-2"></i>Usuários</h1>
    <span class="badge bg-secondary fs-6">
      <i class="bi bi-people me-1"></i><%= @users.count %> <%= @users.count == 1 ? 'usuário' : 'usuários' %>
    </span>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted text-uppercase small">Usuários cadastrados</div>
          <div class="display-6 fw-semibold"><%= @metrics.users_count %></div>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-body">
          <div class="text-muted text-uppercase small">Contatos totais</div>
          <div class="display-6 fw-semibold"><%= @metrics.contacts_count %></div>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center mb-1">
        <div class="text-muted text-uppercase small">Contatos por semana</div>
        <span class="badge bg-light text-secondary">8 semanas</span>
      </div>
      <div class="d-flex align-items-end gap-2" style="height: 120px;">
        <% max_total = @metrics.max_weekly_total %>
        <% @metrics.weekly_contacts.each do |week| %>
          <% height = max_total.zero? ? 0 : (week[:total] * 100 / max_total) %>
          <div class="flex-fill text-center d-flex flex-column justify-content-end h-100">
            <div class="small fw-semibold"><%= week[:total] %></div>
            <div class="bg-primary rounded-top" style="height: <%= height %>%;"></div>
            <div class="text-muted" style="font-size: 0.7rem;"><%= week[:label] %></div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>Nome</th>
            <th>E-mail</th>
            <th class="text-center">Perfil</th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td><%= user.name %></td>
              <td><%= user.email %></td>
              <td class="text-center">
                <% if user.admin? %>
                  <span class="badge bg-primary">Admin</span>
                <% else %>
                  <span class="badge bg-secondary">Padrão</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
