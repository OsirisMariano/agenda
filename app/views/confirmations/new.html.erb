<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6 col-xl-4">
      <div class="text-center mb-4">
        <i class="bi bi-envelope-check text-primary" style="font-size: 3rem;"></i>
        <h1 class="h3 mt-2 fw-normal">Reenviar confirmação</h1>
      </div>

      <div class="card shadow-sm">
        <div class="card-body p-4">
          <p class="text-muted">
            Digite o e-mail usado no cadastro. Se a conta existir e ainda não estiver
            confirmada, enviamos um novo link.
          </p>

          <%= form_with url: reenviar_confirmacao_path, method: :post, local: true do |form| %>
            <div class="mb-3">
              <%= form.label :email, "E-mail", class: 'form-label' %>
              <%= form.email_field :email, class: 'form-control', placeholder: 'name@example.com' %>
            </div>

            <%= form.submit "Reenviar e-mail", class: 'btn btn-primary w-100 py-2' %>
          <% end %>

          <p class="mt-3 text-center mb-0">
            <%= link_to 'Voltar para o login', entrar_path %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
