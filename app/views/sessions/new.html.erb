<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6 col-xl-4">
      <div class="text-center mb-4">
        <i class="bi bi-collection text-primary" style="font-size: 3rem;"></i>
        <h1 class="h3 mt-2 fw-normal">Entrar</h1>
      </div>

      <div class="card shadow-sm">
        <div class="card-body p-4">
          <%= form_with url: entrar_path, local: true do |form| %>
            <div class="mb-3">
              <%= form.label :email, "E-mail", class: 'form-label' %>
              <%= form.email_field :email, class: 'form-control', placeholder: 'name@example.com' %>
            </div>

            <div class="mb-3">
              <%= form.label :password, "Senha", class: 'form-label' %>
              <%= form.password_field :password, class: 'form-control', placeholder: 'Senha' %>
            </div>

            <div class="form-check mb-3">
              <%= form.check_box :remember_me, class: 'form-check-input' %>
              <%= form.label :remember_me, "Lembrar-me", class: 'form-check-label' %>
            </div>

            <%= form.submit "Entrar", class: 'btn btn-primary w-100 py-2' %>

            <p class="mt-3 text-muted text-center">Não tem conta? <%= link_to 'Cadastre-se', cadastro_path %></p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>