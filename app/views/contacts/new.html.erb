<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
          <h5 class="mb-0"><i class="bi bi-person-plus me-2"></i>Novo Contato</h5>
        </div>
        <div class="card-body">
          <%= form_for @contact do |f| %>
            <div class="mb-3">
              <%= f.label :name, "Nome", class: 'form-label' %>
              <%= f.text_field :name, class: form_field_class(f, :name), placeholder: 'Nome completo' %>
              <%= form_field_error(f, :name) %>
            </div>
            <div class="mb-3">
              <%= f.label :phone, "Telefone", class: 'form-label' %>
              <%= f.text_field :phone, class: form_field_class(f, :phone), placeholder: '(00) 00000-0000' %>
              <%= form_field_error(f, :phone) %>
            </div>
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
              <%= link_to 'Cancelar', contacts_path, class: 'btn btn-outline-secondary' %>
              <%= f.submit 'Criar Contato', class: 'btn btn-primary' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>