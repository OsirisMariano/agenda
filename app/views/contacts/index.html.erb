<div class="container py-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0"><i class="bi bi-people me-2"></i>Meus Contatos</h1>
    <%= link_to new_contact_path, class: 'btn btn-primary' do %>
      <i class="bi bi-plus-circle me-2"></i>Novo Contato
    <% end %>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-8">
          <%= form_with url: contacts_path, method: :get, class: "d-flex gap-2" do |f| %>
            <%= f.text_field :q, value: params[:q], class: "form-control", placeholder: "Buscar por nome ou telefone..." %>
            <%= f.select :sort, options_for_select([["Ordenar por", ""], ["Nome (A-Z)", "name"], ["Mais recentes", "created_at"]], params[:sort]), {}, class: "form-select" %>
            <%= f.submit "Buscar", class: "btn btn-outline-primary" %>
            <% if params[:q].present? || params[:sort].present? %>
              <%= link_to "Limpar", contacts_path, class: "btn btn-outline-secondary" %>
            <% end %>
          <% end %>
        </div>
        <div class="col-md-4 text-md-end">
          <span class="badge bg-secondary fs-6">
            <i class="bi bi-person-check me-1"></i><%= @pagy.count %> <%= @pagy.count == 1 ? 'contato' : 'contatos' %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <% if @contacts.empty? %>
    <div class="card border-0 shadow-sm text-center py-5">
      <div class="card-body">
        <% if params[:q].present? %>
          <i class="bi bi-search display-1 text-muted"></i>
          <h3 class="mt-3 text-muted">Nenhum resultado encontrado</h3>
          <p class="text-muted">Tente buscar por outro termo.</p>
          <%= link_to 'Limpar busca', contacts_path, class: 'btn btn-outline-primary' %>
        <% else %>
          <i class="bi bi-person-plus display-1 text-muted"></i>
          <h3 class="mt-3 text-muted">Sem contatos cadastrados</h3>
          <p class="text-muted">Comece adicionando seu primeiro contato!</p>
          <%= link_to 'Adicionar Contato', new_contact_path, class: 'btn btn-primary' %>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="row g-3 g-md-4">
      <% @contacts.each do |contact| %>
        <div class="col-12 col-sm-6 col-lg-4">
          <div class="card h-100 shadow-sm">
            <div class="card-body">
              <div class="d-flex align-items-start">
                <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3 flex-shrink-0">
                  <i class="bi bi-person-fill text-primary fs-4"></i>
                </div>
                <div class="flex-grow-1 overflow-hidden">
                  <h5 class="card-title mb-1 text-truncate"><%= contact.name %></h5>
                  <p class="card-text text-muted mb-0 text-truncate">
                    <i class="bi bi-telephone me-2"></i><%= contact.phone %>
                  </p>
                </div>
              </div>
            </div>
            <div class="card-footer bg-transparent">
              <div class="d-flex gap-2">
                <%= link_to edit_contact_path(contact), class: 'btn btn-warning btn-sm flex-grow-1' do %>
                  <i class="bi bi-pencil me-1"></i><span class="d-none d-sm-inline">Editar</span>
                <% end %>
                <%= button_to contact_path(contact), method: :delete, 
                    class: 'btn btn-danger btn-sm flex-grow-1',
                    form: { data: { turbo_confirm: "Tem certeza que deseja excluir #{contact.name}?" } } do %>
                  <i class="bi bi-trash me-1"></i><span class="d-none d-sm-inline">Excluir</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% if @pagy.pages > 1 %>
      <div class="d-flex justify-content-center mt-4">
        <%= pagy_bootstrap_nav(@pagy).html_safe %>
      </div>
    <% end %>
  <% end %>
</div>