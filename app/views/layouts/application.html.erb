<!DOCTYPE html>
<html>
  <head>
    <title>Agenda!</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/@hotwired/strurbo-rails@7.3.0/dist/strurbo-rails.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </head>
  <body>
    <%= render 'layouts/header' if user_signed_in? %>

    <main class="min-vh-100<%= ' py-5' unless user_signed_in? %>">
      <% flash.each do |message_type, message| %>
        <div class="container mt-3">
          <div class="alert alert-<%= message_type == 'alert' ? 'danger' : message_type %> alert-dismissible fade show" role="alert">
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            <%= message %>
          </div>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <script>
      function showLoading(button) {
        if (button.disabled) return;
        button.disabled = true;
        button.dataset.originalText = button.value || button.innerHTML;
        button.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Salvando...';
        button.classList.add('disabled');
      }

      function hideLoading(button) {
        if (button && button.dataset.originalText) {
          button.disabled = false;
          button.value = button.dataset.originalText;
          button.innerHTML = button.dataset.originalText;
          button.classList.remove('disabled');
        }
      }

      document.addEventListener('turbo:submit-start', function(event) {
        const form = event.target;
        const submitBtn = form.querySelector('input[type="submit"], button[type="submit"]');
        if (submitBtn) showLoading(submitBtn);
      });

      document.addEventListener('turbo:submit-end', function(event) {
        const form = event.target;
        const submitBtn = form.querySelector('input[type="submit"], button[type="submit"]');
        if (submitBtn) hideLoading(submitBtn);
      });

      document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('form').forEach(function(form) {
          form.addEventListener('submit', function(event) {
            if (!form.dataset.turbo) {
              const submitBtn = form.querySelector('input[type="submit"], button[type="submit"]');
              if (submitBtn) showLoading(submitBtn);
            }
          });
        });
      });
    </script>

    <%= render 'layouts/footer' if user_signed_in? %>
  </body>
</html>