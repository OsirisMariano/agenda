<footer class="py-5 bg-light">
  <div class="container">
    <div class="row">
      <div class="col-6 col-md-6 mb-3">
        <h5 class="text-body-secondary mb-2">Navegação</h5>
        <div class="d-flex flex-column gap-2">
          <%= link_to 'Home', root_path, class: 'text-muted text-decoration-none' %>
          <%= link_to 'Contatos', contacts_path, class: 'text-muted text-decoration-none' %>
          <%= link_to 'Sobre', sobre_path, class: 'text-muted text-decoration-none' %>
        </div>
      </div>

      <div class="col-6 col-md-6 mb-3">
        <h5 class="text-body-secondary mb-2">Conta</h5>
        <div class="d-flex flex-column gap-2">
          <%= link_to 'Meus Contatos', contacts_path, class: 'text-muted text-decoration-none' %>
          <%= button_to 'Sair', sair_path, method: :delete, class: 'text-muted text-decoration-none btn btn-link p-0 text-start' %>
        </div>
      </div>
    </div>

    <div class="py-4 border-top">
      <p class="mb-0 text-muted">&copy; <%= Date.today.year %> Agenda. Todos os direitos reservados.</p>
    </div>
  </div>
</footer>
